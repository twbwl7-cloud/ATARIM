# ── Public (safe on client) ─────────────────────────────────────────
# מספר וואטסאפ בפורמט בינלאומי (ללא +)
NEXT_PUBLIC_WHATSAPP_NUMBER=972523182032

# כתובת האתר בפרודקשן (OG / sitemap)
NEXT_PUBLIC_SITE_URL=https://davidwebsitebuilder.vercel.app

# ── Server-only secrets (never NEXT_PUBLIC_) ────────────────────────
# מייל שמקבל לידים מהטופס (ברירת מחדל: Twbwl7@gmail.com)
CONTACT_TO_EMAIL=Twbwl7@gmail.com

# Resend — שליחת מייל מהשרת
# צרו מפתח ב־https://resend.com/api-keys והדביקו כאן + ב־Vercel Env
RESEND_API_KEY=

# אופציונלי: כתובת שולח מאומתת ב־Resend (אחרי אימות דומיין)
# CONTACT_FROM_EMAIL=David Tubul <leads@your-domain.com>

# WhatsApp bot / automation webhook (Make / Zapier / n8n / CallMeBot) — optional
# The contact form does NOT redirect visitors to WhatsApp.
WHATSAPP_BOT_URL=PLACEHOLDER_URL

# Google Sheets / Excel table — every lead becomes a new row
# Setup: see scripts/google-sheets-leads.gs (Apps Script Web App URL)
# Example: https://script.google.com/macros/s/XXXX/exec
GOOGLE_SHEETS_WEBHOOK_URL=

